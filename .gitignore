# ==============================================================================
# PREVER (SMDN) — Configuração Global do .gitignore (Monorepo)
# ==============================================================================

# ─── Dependências ────────────────────────────────────────────────────────────
node_modules/
**/node_modules/
.pnp
.pnp.js

# ─── Builds, Empacotamento e Frameworks ──────────────────────────────────────
dist/
**/dist/
dist-ssr/
**/dist-ssr/
build/
**/build/
.expo/
**/.expo/
.next/
**/.next/
.turbo/
**/.turbo/
.vercel/
**/.vercel/
out/

# ─── Cobertura de Testes ─────────────────────────────────────────────────────
coverage/
**/coverage/
*.lcov
.nyc_output/

# ─── Logs e Diagnósticos ─────────────────────────────────────────────────────
logs/
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ─── Variáveis de Ambiente e Segredos (OWASP) ────────────────────────────────
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example
*.pem
*.key
google-services.json
GoogleService-Info.plist

