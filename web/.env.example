# ==============================================================================
# PREVER — Variáveis de Ambiente do Painel Web (/web/.env)
# ==============================================================================
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_GOOGLE_MAPS_API_KEY=
VITE_DEV_BYPASS_AUTH=false
VITE_DEV_BYPASS_ADMIN=false
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VERTEX_LOCATION=global
VITE_FIREBASE_VERTEX_MODEL=gemini-2.5-flash
# Firebase App Check (reCAPTCHA Enterprise)
VITE_FIREBASE_APPCHECK_RECAPTCHA_SITE_KEY=
# Apenas dev local; autorize o token no Console do Firebase
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=false
# Função serverless /api/prever-ai (Vercel) - apenas servidor
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
