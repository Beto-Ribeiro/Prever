# ==============================================================================
# PREVER (SMDN) — Exemplo de Variáveis de Ambiente do Monorepo
# Copie este arquivo para `.env` (em `/mobile/.env` e `/web/.env`) e preencha
# com as credenciais do seu ambiente. NUNCA versione arquivos `.env` reais.
# ==============================================================================

# ─── Configurações Gerais / Backend & Mobile (/mobile/.env) ──────────────────
API_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
OPENWEATHER_API_KEY=
GOOGLE_MAPS_API_KEY=
FIREBASE_WEB_API_KEY=
FIREBASE_ANDROID_API_KEY=
FIREBASE_IOS_API_KEY=
FIREBASE_PROJECT_ID=

# ─── Painel Web Operacional & Administrativo (/web/.env) ─────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_GOOGLE_MAPS_API_KEY=
VITE_DEV_BYPASS_AUTH=false
VITE_DEV_BYPASS_ADMIN=false

# ─── Supabase Edge Functions (/supabase/functions) ───────────────────────────
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
WEB_APP_URL=
ALLOWED_ORIGINS=
